@misc{sample_ecg_data,
  title = {Dataset: sample\_ecg},
  year = {2025},
  howpublished = {\texttt{sample\_ecg} is a subset of the human STRING network (version 12.0) with interaction scores of 900 or higher. Vertex IDs are Entrez Gene IDs (see Carlson, 2019). The network has been trimmed to create a smaller, more manageable example for the package's vignettes and tests. Source: string-db.org. Data from STRING is licensed under CC BY 4.0.}
}

@misc{sample_ects_data,
  title = {Dataset: sample\_ects},
  year = {2025},
  howpublished = {\texttt{sample\_ects} is derived from Gene Ontology (GO) term-to-gene mappings (see Ashburner et al., 2000; GO Consortium, 2023). Element IDs are Entrez Gene IDs (see Carlson, 2019). Source: geneontology.org. GO data is licensed under CC BY 4.0.}
}
